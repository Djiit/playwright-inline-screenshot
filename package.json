{
  "name": "playwright-inline-screenshot",
  "version": "0.1.0",
  "description": "Inline screenshots for Playwright tests — failed-test screenshots rendered inline in iTerm2 and Buildkite build logs",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "playwright",
    "buildkite",
    "screenshot",
    "inline-images",
    "iterm2",
    "ci"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
